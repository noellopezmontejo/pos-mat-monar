generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  legacy_code String?   @unique
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  created_by  String?
  products    Product[]
}

model Supplier {
  id                   String               @id @default(uuid())
  name                 String
  rfc                  String?
  phone                String?
  email                String?
  address              String?
  legacy_code          String?              @unique
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  deleted_at           DateTime?
  created_by           String?
  credit_days          Int                  @default(0)
  products             Product[]
  purchases            PurchaseOrder[]
  purchase_suggestions PurchaseSuggestion[]
  credits              SupplierCreditNote[]
  payments             SupplierPayment[]
  returns              SupplierReturn[]
}

model Product {
  id                    String                  @id @default(uuid())
  name                  String
  description           String?
  barcode               String?                 @unique
  legacy_code           String?                 @unique
  category_id           String
  supplier_id           String?
  model                 String?
  base_unit             String
  purchase_unit         String?
  sale_unit             String?
  unit_factor           Float                   @default(1)
  weight                Float?                  @default(0)
  volume                Float?                  @default(0)
  status                String                  @default("Activo")
  tax_scheme_id         String?
  cost                  Int                     @default(0)
  last_cost             Int                     @default(0)
  avg_cost              Int                     @default(0)
  price_1               Int                     @default(0)
  price_2               Int                     @default(0)
  price_3               Int                     @default(0)
  price_4               Int                     @default(0)
  price_5               Int                     @default(0)
  price_6               Int                     @default(0)
  min_stock             Int                     @default(0)
  max_stock             Int                     @default(0)
  has_lots              Boolean                 @default(false)
  has_series            Boolean                 @default(false)
  is_service            Boolean                 @default(false)
  image_url             String?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  deleted_at            DateTime?
  created_by            String?
  line_id               String?
  is_kit                Boolean                 @default(false)
  customer_return_items CustomerReturnItem[]
  kardex                Kardex[]
  component_in          KitComponent[]          @relation("ComponentToProduct")
  kit_components        KitComponent[]          @relation("KitToProduct")
  category              Category                @relation(fields: [category_id], references: [id])
  line                  ProductLine?            @relation(fields: [line_id], references: [id])
  supplier              Supplier?               @relation(fields: [supplier_id], references: [id])
  tax_scheme            TaxScheme?              @relation(fields: [tax_scheme_id], references: [id])
  conversions_from      ProductConversion[]     @relation("ConversionSource")
  conversions_to        ProductConversion[]     @relation("ConversionTarget")
  purchase_items        PurchaseOrderItem[]
  purchase_suggestions  PurchaseSuggestion[]
  reception_items       ReceptionItem[]
  sale_items            SaleItem[]
  stock                 Stock[]
  supplier_return_items SupplierReturnItem[]
  transfer_items        WarehouseTransferItem[]
}

model TaxScheme {
  id          String    @id @default(uuid())
  num_reg     Int?
  code        String    @unique
  name        String
  tax1_rate   Float     @default(0)
  tax1_apply  Int       @default(0)
  tax2_rate   Float     @default(0)
  tax2_apply  Int       @default(0)
  tax3_rate   Float     @default(0)
  tax3_apply  Int       @default(0)
  tax4_rate   Float     @default(0)
  tax4_apply  Int       @default(0)
  coi_account String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  products    Product[]
}

model ProductLine {
  id          String    @id @default(uuid())
  num_reg     Int?
  code        String    @unique
  name        String
  coi_account String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  products    Product[]
}

model Customer {
  id                String            @id @default(uuid())
  name              String
  phone             String?
  address           String?
  delivery_zone     String?
  customer_type     String            @default("P1")
  credit_limit      Int               @default(0)
  credit_days       Int               @default(0)
  seller_id         String?
  legacy_code       String?           @unique
  fiscal_id         String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  deleted_at        DateTime?
  created_by        String?
  credits           Credit[]
  fiscal_client     FiscalClient?     @relation(fields: [fiscal_id], references: [id])
  customer_payments CustomerPayment[]
  returns           CustomerReturn[]
  sales             Sale[]
}

model Stock {
  id         String   @id @default(uuid())
  product_id String
  branch_id  String
  quantity   Int      @default(0)
  committed  Int      @default(0)
  updated_at DateTime @updatedAt
  branch     Branch   @relation(fields: [branch_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])

  @@unique([product_id, branch_id])
}

model Kardex {
  id         String   @id @default(uuid())
  product_id String
  branch_id  String?
  type       String
  reason     String
  quantity   Int
  balance    Int
  cost       Float?   @default(0)
  price      Float?   @default(0)
  reference  String?
  user_id    String
  created_at DateTime @default(now())
  branch     Branch?  @relation(fields: [branch_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
}

model Sale {
  id                String            @id @default(uuid())
  folio             String            @unique
  customer_id       String
  type              String
  status            String
  created_at        DateTime          @default(now())
  document_date     DateTime?
  total_amount      Float?
  subtotal          Float?
  discount          Float?
  taxes             Float?
  warehouse_id      String?
  observations      String?
  created_by        String
  updated_at        DateTime          @updatedAt
  payment_method    String?
  collected_at      DateTime?
  collected_by      String?
  collected_method  String?
  liquidated_at     DateTime?
  liquidated_by     String?
  liquidation_notes String?
  balance           Float?            @default(0)
  customer_payments CustomerPayment[]
  delivery          Delivery?
  customer          Customer          @relation(fields: [customer_id], references: [id])
  warehouse         Branch?           @relation("SaleWarehouse", fields: [warehouse_id], references: [id])
  items             SaleItem[]
  cfdis             CFDI[]            @relation("SaleToCFDI")
}

model SaleItem {
  id             String  @id @default(uuid())
  sale_id        String
  product_id     String
  quantity       Int
  price          Float?  @default(0)
  cost           Float?  @default(0)
  discount       Float?  @default(0)
  tax_percentage Float?  @default(0)
  warehouse_id   String?
  unit           String?
  product        Product @relation(fields: [product_id], references: [id])
  sale           Sale    @relation(fields: [sale_id], references: [id])
  warehouse      Branch? @relation("SaleItemWarehouse", fields: [warehouse_id], references: [id])
}

model Vehicle {
  id              String   @id @default(uuid())
  name            String
  plate           String   @unique
  type            String
  brand           String?
  model           String?
  year            Int?
  capacity_weight Float    @default(0)
  capacity_volume Float    @default(0)
  status          String   @default("Disponible")
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  drivers         Driver[]
  routes          Route[]
}

model Driver {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  license      String?
  license_type String?
  vehicle_id   String?
  status       String   @default("Activo")
  notes        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  vehicle      Vehicle? @relation(fields: [vehicle_id], references: [id])
  routes       Route[]
  users        User[]
}

model Route {
  id               String     @id @default(uuid())
  name             String
  created_at       DateTime   @default(now())
  driver_id        String?
  status           String     @default("Pendiente")
  vehicle_id       String?
  current_lat      Float?
  current_lng      Float?
  last_location_at DateTime?
  tracking_active  Boolean    @default(false)
  deliveries       Delivery[]
  driver           Driver?    @relation(fields: [driver_id], references: [id])
  vehicle          Vehicle?   @relation(fields: [vehicle_id], references: [id])
}

model Delivery {
  id                 String    @id @default(uuid())
  sale_id            String    @unique
  route_id           String?
  status             String
  address            String
  lat                Float?
  lng                Float?
  updated_at         DateTime  @updatedAt
  attempt_count      Int       @default(1)
  created_at         DateTime  @default(now())
  delivered_at       DateTime?
  extra_charges      Float     @default(0)
  extra_charges_note String?
  fail_notes         String?
  fail_reason        String?
  proof_notes        String?
  route              Route?    @relation(fields: [route_id], references: [id])
  sale               Sale      @relation(fields: [sale_id], references: [id])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  folio          String              @unique
  supplier_id    String
  status         String
  created_at     DateTime            @default(now())
  document_date  DateTime?
  reception_date DateTime?
  payment_date   DateTime?
  total_amount   Float?
  subtotal       Float?
  discount       Float?
  taxes          Float?
  warehouse_id   String?
  observations   String?
  supplier       Supplier            @relation(fields: [supplier_id], references: [id])
  warehouse      Branch?             @relation("PurchaseWarehouse", fields: [warehouse_id], references: [id])
  items          PurchaseOrderItem[]
  receptions     Reception[]
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchase_order_id String
  product_id        String
  quantity          Int
  quantity_received Int           @default(0)
  cost              Float?        @default(0)
  price             Float?        @default(0)
  discount          Float?        @default(0)
  tax_percentage    Float?        @default(0)
  unit              String?
  warehouse_id      String?
  product           Product       @relation(fields: [product_id], references: [id])
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  warehouse         Branch?       @relation("PurchaseItemWarehouse", fields: [warehouse_id], references: [id])
}

model Reception {
  id                String            @id @default(uuid())
  purchase_order_id String
  received_by       String
  observations      String?
  total_amount      Float?
  billed_amount     Float?
  created_at        DateTime          @default(now())
  status            String            @default("Activa")
  canceled_at       DateTime?
  canceled_by       String?
  purchase_order    PurchaseOrder     @relation(fields: [purchase_order_id], references: [id])
  items             ReceptionItem[]
  payments          SupplierPayment[]
}

model ReceptionItem {
  id           String    @id @default(uuid())
  reception_id String
  product_id   String
  quantity     Int
  cost         Float?    @default(0)
  product      Product   @relation(fields: [product_id], references: [id])
  reception    Reception @relation(fields: [reception_id], references: [id])
}

model FiscalClient {
  id            String     @id @default(uuid())
  rfc           String     @unique
  business_name String
  regime        String
  cfdi_use      String
  email         String?
  address       String?
  colony        String?
  exterior      String?
  interior      String?
  municipality  String?
  state         String?
  street        String?
  zip_code      String?
  customers     Customer[]
}

model CFDI {
  id                  String           @id @default(uuid())
  uuid                String?          @unique
  type                String
  status              String           @default("TIMBRADO")
  xml_url             String?
  pdf_url             String?
  created_at          DateTime         @default(now())
  canceled_at         DateTime?
  cancellation_reason String?
  cancellation_status String?
  related_uuid        String?
  relation_type       String?
  subtotal            Float            @default(0)
  taxes               Float            @default(0)
  total_amount        Float            @default(0)
  customer_returns    CustomerReturn[]
  sales               Sale[]           @relation("SaleToCFDI")
}

model Credit {
  id          String   @id @default(uuid())
  customer_id String
  amount      Int
  balance     Int
  due_date    DateTime
  status      String
  created_at  DateTime @default(now())
  customer    Customer @relation(fields: [customer_id], references: [id])
}

model SupplierPayment {
  id                String                       @id @default(uuid())
  supplier_id       String
  reception_id      String?
  purchase_order_id String?
  reception_value   Float                        @default(0)
  po_total_value    Float                        @default(0)
  amount            Float                        @default(0)
  balance           Float                        @default(0)
  status            String                       @default("Por Validar")
  due_date          DateTime?
  created_at        DateTime                     @default(now())
  canceled_at       DateTime?
  canceled_by       String?
  reception         Reception?                   @relation(fields: [reception_id], references: [id])
  supplier          Supplier                     @relation(fields: [supplier_id], references: [id])
  transactions      SupplierPaymentTransaction[]
}

model SupplierPaymentTransaction {
  id             String          @id @default(uuid())
  payment_id     String
  amount         Float
  payment_method String          @default("Transferencia")
  reference      String?
  notes          String?
  created_at     DateTime        @default(now())
  status         String          @default("Activo")
  canceled_at    DateTime?
  canceled_by    String?
  payment        SupplierPayment @relation(fields: [payment_id], references: [id])
}

model SupplierCreditNote {
  id          String   @id @default(uuid())
  supplier_id String
  amount      Float
  balance     Float
  reason      String?
  status      String   @default("Disponible")
  created_at  DateTime @default(now())
  supplier    Supplier @relation(fields: [supplier_id], references: [id])
}

model CashSession {
  id               String    @id @default(uuid())
  user_id          String
  opened_at        DateTime  @default(now())
  closed_at        DateTime?
  opening_balance  Int       @default(0)
  closing_balance  Int?
  expected_balance Int?
  status           String    @default("OPEN")
  notes            String?
  user             User      @relation(fields: [user_id], references: [id])
}

model User {
  id            String        @id @default(uuid())
  username      String        @unique
  password      String
  name          String
  role          String
  permissions   String[]
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  driverId      String?
  cash_sessions CashSession[]
  driver        Driver?       @relation(fields: [driverId], references: [id])
}

model Branch {
  id                   String               @id @default(uuid())
  name                 String
  address              String?
  customer_returns     CustomerReturn[]
  kardex               Kardex[]
  conversions          ProductConversion[]
  purchaseOrders       PurchaseOrder[]      @relation("PurchaseWarehouse")
  purchaseItems        PurchaseOrderItem[]  @relation("PurchaseItemWarehouse")
  purchase_suggestions PurchaseSuggestion[]
  sales                Sale[]               @relation("SaleWarehouse")
  saleItems            SaleItem[]           @relation("SaleItemWarehouse")
  stock                Stock[]
  supplier_returns     SupplierReturn[]
  destTransfers        WarehouseTransfer[]  @relation("TransferDest")
  originTransfers      WarehouseTransfer[]  @relation("TransferOrigin")
}

model AuditLog {
  id         String   @id @default(uuid())
  table_name String
  action     String
  user_id    String
  old_data   Json?
  new_data   Json?
  timestamp  DateTime @default(now())
}

model SatRegime {
  id          String @id @default(uuid())
  code        String @unique
  description String
  applies_to  String @default("ALL")
}

model SatCfdiUse {
  id          String @id @default(uuid())
  code        String @unique
  description String
  applies_to  String @default("ALL")
}

model GeoCountry {
  id     String     @id @default(uuid())
  code   String     @unique
  name   String
  states GeoState[]
}

model GeoState {
  id         String        @id @default(uuid())
  code       String
  name       String
  country_id String
  localities GeoLocality[]
  country    GeoCountry    @relation(fields: [country_id], references: [id])
}

model GeoLocality {
  id           String   @id @default(uuid())
  zip_code     String
  settlement   String
  type         String
  municipality String
  state_id     String
  state        GeoState @relation(fields: [state_id], references: [id])
}

model CColonia {
  Id             Int     @id @default(autoincrement())
  c_Colonia      String? @db.VarChar(20)
  c_CodigoPostal String? @db.VarChar(20)
  Nombre         String? @db.VarChar(150)

  @@map("c_colonia")
}

model CCp {
  Id          Int     @id @default(autoincrement())
  c_CP        String? @db.VarChar(50)
  c_Estado    String? @db.VarChar(50)
  c_Municipio String? @db.VarChar(50)
  c_Localidad String? @db.VarChar(50)

  @@map("c_cp")
}

model CEstado {
  Id          Int     @id @default(autoincrement())
  c_Estado    String? @db.VarChar(50)
  c_Pais      String? @db.VarChar(50)
  Descripcion String? @db.VarChar(100)

  @@map("c_estado")
}

model CMunicipio {
  Id          Int     @id @default(autoincrement())
  c_Municipio String? @db.VarChar(50)
  c_Estado    String? @db.VarChar(50)
  Descripcion String? @db.VarChar(100)

  @@map("c_municipio")
}

model CPais {
  Id          Int     @id @default(autoincrement())
  c_Pais      String? @db.VarChar(50)
  Descripcion String? @db.VarChar(100)

  @@map("c_pais")
}

model CatFormaPagoSat {
  CveFormaPago                         Int     @id @default(autoincrement())
  c_FormaPago                          String  @db.VarChar(4)
  Descripcion                          String? @db.VarChar(255)
  Bancarizado                          String? @db.VarChar(255)
  NumOperacion                         String? @db.VarChar(255)
  RfcEmisorOrdenante                   String? @db.VarChar(255)
  CuentaOrdenante                      String? @db.VarChar(255)
  RfcEmisorBeneficiario                String? @db.VarChar(255)
  CuentaBenenficiario                  String? @db.VarChar(255)
  TipoCadenaPago                       String? @db.VarChar(255)
  NombreBancoEmisorOrdenanteExtranjero String? @db.VarChar(255)
  InicioVig                            String? @db.VarChar(10)
  FinVig                               String? @db.VarChar(10)
  PatronCuentaBeneficiaria             String? @map("PatrónCuentaBeneficiaria") @db.VarChar(255)
  PatronCuentaOrdenante                String? @map("PatrónCuentaOrdenante") @db.VarChar(255)

  @@map("catformapagosat")
}

model CatMetodoPagoSat {
  CveMetodoPago Int     @id @default(autoincrement())
  c_metodopago  String  @db.VarChar(5)
  Descripcion   String? @db.VarChar(100)
  InicioVig     String? @db.VarChar(10)
  FinVig        String? @db.VarChar(10)

  @@map("catmetodopagosat")
}

model CatRegimenSatNuevo {
  CveRegimen    Int     @id @default(autoincrement())
  CveTipoEmisor Int?
  Regimen       String  @db.VarChar(10)
  Descripcion   String? @db.VarChar(255)
  Fisica        String? @db.VarChar(255)
  Moral         String? @db.VarChar(255)
  InicioVig     String? @db.VarChar(10)
  FinVig        String? @db.VarChar(10)

  @@map("catregimensat")
}

model CatUsoCfdiSatNuevo {
  CveUso      Int     @id @default(autoincrement())
  c_UsoCFDI   String  @db.VarChar(5)
  Descripcion String? @db.VarChar(255)
  Persona     String? @db.VarChar(2)
  InicioVig   String? @db.VarChar(10)
  FinVig      String? @db.VarChar(10)

  @@map("catusocfdisat")
}

model CustomerPayment {
  id             String   @id @default(uuid())
  customer_id    String
  sale_id        String?
  amount         Float
  payment_method String
  reference      String?
  created_at     DateTime @default(now())
  created_by     String
  status         String   @default("APPLIED")
  customer       Customer @relation(fields: [customer_id], references: [id])
  sale           Sale?    @relation(fields: [sale_id], references: [id])
}

model CompanyProfile {
  id              String   @id @default(uuid())
  name            String   @default("CIMENTA")
  trade_name      String?
  rfc             String?
  address         String?
  phone           String?
  email           String?
  website         String?
  logo_url        String?
  receipt_message String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  ticket_config   Json?    @default("{\"show_rfc\": true, \"show_logo\": true, \"show_phone\": true, \"show_address\": true, \"show_barcode\": true, \"show_customer\": true, \"show_trade_name\": true}")
  app_icon_url    String?
  app_logo_url    String?
  app_name        String?  @default("NC INTEGRAX")
  branding_key    String?  @default("NC-2026-ADMIN")
  show_by_nc      Boolean  @default(true)
}

model PurchaseSuggestion {
  id                String    @id @default(uuid())
  product_id        String
  supplier_id       String?
  branch_id         String?
  current_stock     Int       @default(0)
  min_stock         Int       @default(0)
  max_stock         Int       @default(0)
  suggested_qty     Int       @default(0)
  last_cost         Int       @default(0)
  status            String    @default("PENDIENTE")
  triggered_by      String?
  purchase_order_id String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  branch            Branch?   @relation(fields: [branch_id], references: [id])
  product           Product   @relation(fields: [product_id], references: [id])
  supplier          Supplier? @relation(fields: [supplier_id], references: [id])
}

model KitComponent {
  id             String  @id @default(uuid())
  kit_product_id String
  component_id   String
  quantity       Int
  component      Product @relation("ComponentToProduct", fields: [component_id], references: [id])
  kit_product    Product @relation("KitToProduct", fields: [kit_product_id], references: [id])

  @@unique([kit_product_id, component_id])
}

model WarehouseTransfer {
  id               String                  @id @default(uuid())
  folio            String                  @unique
  origin_branch_id String
  dest_branch_id   String
  status           String                  @default("EN_TRANSITO")
  notes            String?
  created_by       String
  created_at       DateTime                @default(now())
  received_by      String?
  received_at      DateTime?
  dest_branch      Branch                  @relation("TransferDest", fields: [dest_branch_id], references: [id])
  origin_branch    Branch                  @relation("TransferOrigin", fields: [origin_branch_id], references: [id])
  items            WarehouseTransferItem[]
}

model WarehouseTransferItem {
  id          String            @id @default(uuid())
  transfer_id String
  product_id  String
  quantity    Int
  product     Product           @relation(fields: [product_id], references: [id])
  transfer    WarehouseTransfer @relation(fields: [transfer_id], references: [id])
}

model ProductConversion {
  id                String   @id @default(uuid())
  folio             String   @unique
  branch_id         String
  source_product_id String
  target_product_id String
  source_quantity   Int
  target_quantity   Int
  conversion_factor Float
  created_by        String
  created_at        DateTime @default(now())
  branch            Branch   @relation(fields: [branch_id], references: [id])
  source_product    Product  @relation("ConversionSource", fields: [source_product_id], references: [id])
  target_product    Product  @relation("ConversionTarget", fields: [target_product_id], references: [id])
}

model SupplierReturn {
  id                String               @id @default(uuid())
  folio             String               @unique
  supplier_id       String
  branch_id         String
  notes             String?
  cfdi_egreso_uuid  String?
  cfdi_egreso_folio String?
  created_by        String
  created_at        DateTime             @default(now())
  branch            Branch               @relation(fields: [branch_id], references: [id])
  supplier          Supplier             @relation(fields: [supplier_id], references: [id])
  items             SupplierReturnItem[]
}

model SupplierReturnItem {
  id           String         @id @default(uuid())
  return_id    String
  product_id   String
  quantity     Int
  cost         Float          @default(0)
  product      Product        @relation(fields: [product_id], references: [id])
  return_order SupplierReturn @relation(fields: [return_id], references: [id])
}

model CustomerReturn {
  id             String               @id @default(uuid())
  folio          String               @unique
  customer_id    String
  branch_id      String
  notes          String?
  cfdi_egreso_id String?
  created_by     String
  created_at     DateTime             @default(now())
  branch         Branch               @relation(fields: [branch_id], references: [id])
  cfdi_egreso    CFDI?                @relation(fields: [cfdi_egreso_id], references: [id])
  customer       Customer             @relation(fields: [customer_id], references: [id])
  items          CustomerReturnItem[]
}

model CustomerReturnItem {
  id           String         @id @default(uuid())
  return_id    String
  product_id   String
  quantity     Int
  price        Float          @default(0)
  product      Product        @relation(fields: [product_id], references: [id])
  return_order CustomerReturn @relation(fields: [return_id], references: [id])
}
